{
  "name": "@tolt/api",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Tolt Public API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toltapp/tolt-typescript-sdk.git"
  },
  "homepage": "https://github.com/toltapp/tolt-typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/toltapp/tolt-typescript-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.6.0"
  }
}
